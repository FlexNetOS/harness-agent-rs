# Rust build artifacts
/target

# Track the hand-authored harness (cold-resume from committed state); ignore local Claude settings
.claude/*
!.claude/agents/
!.claude/skills/

# Loop runner logs (durable state — backlog/ledger/HANDOFF in .handoff/loop — is committed; logs are not)
.handoff/loop/*.log
.handoff/loop/ralph-run-*.log

# handoff continuity: local ledger is gitignored (ADR-0004 §3.3/§6 rev, HFTASK-0035)
.handoff/**/ledger.db
.handoff/**/*.db-wal
.handoff/**/*.db-shm

# === handoff continuity kernel — canonical .handoff durability policy (ADR-0016) ===
# REGENERABLE .handoff state (rebuilt by `hf` from the authoritative ledger): never commit.
# CONTENTS-FORM only — NEVER a bare `.handoff/` or `.claude/` ignore: Git cannot re-include a
# path past an excluded parent dir, so a dir-form ignore silently SWALLOWS durable ledgers
# (tasks/, decisions/, loop/*.md). Run `hf gitignore --check` (or `hf doctor`) to detect it.
.handoff/**/ledger.db
.handoff/**/*.db-wal
.handoff/**/*.db-shm
.handoff/**/*.rvf
.handoff/**/*.rvf.lock
/.handoff/packets/
/.handoff/workspaces/
/.handoff/locks/
/.handoff/deliveries/
/.handoff/active.md

# handoff continuity: binary ledger cache + migration artifacts are gitignored
# (committed truth = .handoff/ledger.events.jsonl — ADR-0018 D1 / HFTASK-0067)
.handoff/**/*.sqlite.bak
.handoff/**/*.redb.tmp
